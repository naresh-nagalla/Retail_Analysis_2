pipeline {
    agent any

    environment {
        VENV_DIR = 'retail_pipeline_venv'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup Virtual Environment and Install Dependencies') {
            steps {
                sh '''
                    set -e
                    echo "🐍 Setting up Python virtual environment..."

                    # Create virtual environment
                    python3 -m venv ${VENV_DIR}
                    source ${VENV_DIR}/bin/activate

                    # Generate requirements.txt if missing
                    if [ ! -f requirements.txt ]; then
                        echo "⚠️ requirements.txt not found. Checking for Pipfile..."
                        if [ -f Pipfile ]; then
                            echo "✅ Pipfile found. Using pipenv to generate requirements.txt..."
                            pipenv lock --requirements > requirements.txt
                        else
                            echo "❌ Neither requirements.txt nor Pipfile found. Exiting."
                            exit 1
                        fi
                    fi

                    # Install dependencies
                    echo "📦 Installing dependencies..."
                    ${VENV_DIR}/bin/pip install --upgrade pip
                    ${VENV_DIR}/bin/pip install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    echo "🧪 Running tests..."
                    source ${VENV_DIR}/bin/activate
                    python -m unittest discover -s tests
                    echo "✅ All tests passed."
                '''
            }
        }

        stage('Package') {
            steps {
                sh '''
                    echo "📦 Packaging project..."
                    source ${VENV_DIR}/bin/activate
                    mkdir -p dist
                    zip -r dist/retail_pipeline.zip . -x "${VENV_DIR}/*"
                    echo "✅ Packaged as dist/retail_pipeline.zip"
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    echo "🚀 Deploying project..."
                    source ${VENV_DIR}/bin/activate
                    unzip -o dist/retail_pipeline.zip -d /tmp/deploy_dir
                    echo "✅ Deployed to /tmp/deploy_dir"
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'dist/*.zip', fingerprint: true
        }
        failure {
            echo '❌ Build failed.'
        }
        success {
            echo '🎉 Build succeeded.'
        }
    }
}
