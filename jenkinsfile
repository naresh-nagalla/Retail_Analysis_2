pipeline {
    agent any

    environment {
        LABS = credentials('labcreds')
        JAVA_HOME = '/opt/bitnami/java' // Set your JAVA_HOME path here.
        PATH = "${env.JAVA_HOME}/bin:${env.PATH}" // Add Java binaries to PATH
    }

    stages {
        stage('Setup Virtual Environment and Install Dependencies') {
            steps {
                script {
                    // Create a virtual environment
                    sh 'python3 -m venv retail_pipeline_venv'
                    
                    // Upgrade pip and install dependencies from requirements.txt
                    sh './retail_pipeline_venv/bin/pip install --upgrade pip'
                    sh './retail_pipeline_venv/bin/pip install -r requirements.txt'
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    // Print JAVA_HOME and PATH for debugging
                    sh 'echo $JAVA_HOME'
                    sh 'echo $PATH'

                    // Run tests using pytest from virtualenv
                    sh './retail_pipeline_venv/bin/pytest'
                }
            }
        }

        stage('Package') {
            steps {
                // Create a zip file excluding the virtual environment folder
                sh 'zip -r retailproject.zip . -x "retail_pipeline_venv/*"'
            }
        }

        stage('Deploy') {
            steps {
                // Deploy the zip file to a remote server
                sh 'sshpass -p $LABS_PSW scp -o StrictHostKeyChecking=no -r retailproject.zip $LABS_USR@g02.itversity.com:/home/itv012419/retailproject'
            }
        }
    }
}
